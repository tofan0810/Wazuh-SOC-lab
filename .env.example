# ========================================================
# WAZUH SOC LAB - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env và điền các giá trị thực tế của bạn:
# cp .env.example .env  (hoặc Copy-Item .env.example .env)
# ========================================================

# --------------------------------------------------------
# 1. THREAT INTELLIGENCE (VIRUSTOTAL API)
# Lấy API key miễn phí tại: https://www.virustotal.com/gui/user/<username>/apikey
# --------------------------------------------------------
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# --------------------------------------------------------
# 2. HẠ TẦNG PHÒNG LAB (MÁY ẢO & THÔNG SỐ KẾT NỐI)
# --------------------------------------------------------
# SSH Host alias hoặc IP máy Kali Linux (Attacker)
LAB_KALI_HOST=kali-vm

# SSH Host alias hoặc IP máy Ubuntu Wazuh Manager (SIEM)
LAB_WAZUH_HOST=wazuh-vm

# Địa chỉ IP của máy Windows 10 (Victim / Endpoint)
LAB_WINDOWS_IP=192.168.71.129

# Tài khoản Local Administrator trên Windows dùng cho WinRM
LAB_WINDOWS_USER=socrunner

# Mật khẩu WinRM (Tùy chọn: Để trống nếu muốn nhập tay mỗi khi chạy test)
# LAB_WINDOWS_PASSWORD=your_password_here

# Tài khoản mục tiêu dùng trong kịch bản RDP Brute Force
LAB_RDP_USER=testw

# --------------------------------------------------------
# 3. CHATOPS NOTIFICATIONS (TELEGRAM BOT)
# Tạo Bot tại: https://t.me/BotFather (lấy Token)
# Lấy Chat ID tại: https://t.me/userinfobot hoặc group ID
# --------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
