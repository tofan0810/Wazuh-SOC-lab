# ==============================================================================
# WAZUH SOC LAB - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# HƯỚNG DẪN SỬ DỤNG:
# 1. Sao chép file này thành .env:
#    cp .env.example .env   (hoặc trên Windows: Copy-Item .env.example .env)
# 2. Điền các giá trị thực tế của bạn vào các mục bên dưới.
# 3. File .env đã được cấu hình trong .gitignore, không bị đẩy lên GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THREAT INTELLIGENCE (VIRUSTOTAL & ABUSEIPDB)
# ------------------------------------------------------------------------------
# Lấy API Key VirusTotal miễn phí tại: https://www.virustotal.com/gui/user/<username>/apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Đăng ký tài khoản và tạo API Key miễn phí (1,000 queries/ngày) tại:
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here


# ------------------------------------------------------------------------------
# 2. JIRA CLOUD CASE MANAGEMENT (ATLASSIAN REST API v3)
# ------------------------------------------------------------------------------
# Tên miền Jira Cloud của bạn (Không cần nhập https://, ví dụ: mycompany.atlassian.net hoặc mycompany)
JIRA_DOMAIN=your_subdomain.atlassian.net

# Email tài khoản Atlassian dùng để quản lý Jira
JIRA_EMAIL=your_email@example.com

# Tạo API Token bí mật tại: https://id.atlassian.com/manage-profile/security/api-tokens
# Nhấn "Create API token" -> Đặt tên (ví dụ: Wazuh-SOAR) -> Sao chép token dán vào đây:
JIRA_API_TOKEN=your_jira_api_token_here

# Mã dự án (Project Key) nơi tiếp nhận ticket sự cố (ví dụ: SEC, SOC, KAN, IT, ...)
# Lưu ý: Project này phải tồn tại trên Jira của bạn.
JIRA_PROJECT_KEY=SEC

# Loại Issue mặc định khi tạo ticket (Thường là: Task, Incident, hoặc Bug)
JIRA_ISSUE_TYPE=Task


# ------------------------------------------------------------------------------
# 3. SOAR & WORKFLOW AUTOMATION ENGINE (n8n DOCKER)
# ------------------------------------------------------------------------------
# Địa chỉ IP hoặc hostname chạy dịch vụ n8n (mặc định chạy trên wazuh-vm)
N8N_HOST=192.168.71.128
N8N_PORT=5678
N8N_PROTOCOL=http

# Webhook URL gốc mà Wazuh Manager sẽ gọi tới
N8N_WEBHOOK_URL=http://192.168.71.128:5678/webhook/wazuh-alert


# ------------------------------------------------------------------------------
# 4. CHATOPS NOTIFICATIONS (TELEGRAM BOT 2-WAY)
# ------------------------------------------------------------------------------
# Tạo Bot và lấy Token qua: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Lấy Chat ID cá nhân qua bot: https://t.me/userinfobot hoặc lấy ID của nhóm SOC
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ------------------------------------------------------------------------------
# 5. HẠ TẦNG PHÒNG LAB (MÁY ẢO & THÔNG SỐ KẾT NỐI E2E TEST)
# ------------------------------------------------------------------------------
# SSH Host alias hoặc IP máy Kali Linux (Attacker VM)
LAB_KALI_HOST=kali-vm

# SSH Host alias hoặc IP máy Ubuntu Wazuh Manager (SIEM VM)
LAB_WAZUH_HOST=wazuh-vm

# Địa chỉ IP của máy Windows 10 (Victim / Endpoint)
LAB_WINDOWS_IP=192.168.71.129

# Tài khoản Local Administrator trên Windows 10 dùng cho WinRM
LAB_WINDOWS_USER=socrunner

# Mật khẩu WinRM của máy Windows 10
LAB_WINDOWS_PASSWORD=your_windows_password_here

# Tài khoản mục tiêu dùng trong kịch bản tấn công RDP Brute Force
LAB_RDP_USER=testw
