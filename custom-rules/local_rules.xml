<!-- Local rules -->

<group name="local_rules,sysmon,windows,killchain,suricata,">

  <!-- ===================================================================== -->
  <!-- SCENARIO 1: Windows RDP Brute Force Detection (T1110)                  -->
  <!-- ===================================================================== -->
  <rule id="100001" level="12" frequency="5" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <description>Windows Brute Force Attack Detected</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- ===================================================================== -->
  <!-- SCENARIO 2: Web LFI / Directory Traversal Detection (T1190)            -->
  <!-- ===================================================================== -->
  <rule id="100002" level="10">
    <if_sid>31100</if_sid>
    <match>win.ini|boot.ini|..%2f|..%252f|../</match>
    <description>WARNING: Local File Inclusion (LFI) / Directory Traversal Attempt Detected on Windows Endpoint</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- ===================================================================== -->
  <!-- STAGE 1: Malicious PowerShell Execution (T1059.001)                    -->
  <!-- ===================================================================== -->
  <!-- Rule cha (100003): Hứng toàn bộ Process Create từ Sysmon Event 1      -->
  <rule id="100003" level="0">
    <if_sid>92021, 92066, 92031, 92032, 92052, 60000, 61603</if_sid>
    <description>Sysmon Event 1 Process Create Base Filter</description>
  </rule>

  <!-- Rule 100004: Detects ALL Encoded/Hidden PowerShell executions (Level 12) -->
  <rule id="100004" level="12">
    <if_sid>100003</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-EncodedCommand|-enc|-w\s+hidden|-nop)</field>
    <description>CRITICAL WARNING: Malicious PowerShell Execution with Encoded/Hidden parameters detected!</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- Rule 100008: Child Suppression Rule (Level 0) for SOAR Remediation (True AND logic) -->
  <rule id="100008" level="0">
    <if_sid>100004</if_sid>
    <field name="win.eventdata.user" type="pcre2">(?i)socrunner</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)(cmd|wsmprovhost|winrshost)\.exe</field>
    <description>Suppression: Authorized SOAR Remediation PowerShell execution via WinRM</description>
  </rule>

  <!-- ===================================================================== -->
  <!-- STAGE 2: Privilege Escalation - UAC Bypass via Registry (T1548.002)   -->
  <!-- ===================================================================== -->
  <rule id="100007" level="12">
    <if_sid>61614, 61615, 61616</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)ms-settings</field>
    <description>CRITICAL WARNING: UAC Bypass attempt detected via ms-settings registry hijacking</description>
    <mitre>
      <id>T1548.002</id>
    </mitre>
  </rule>

  <!-- Rule 100009: Child Suppression Rule (Level 0) for Authorized Remediation Cleanup -->
  <rule id="100009" level="0">
    <if_sid>100007</if_sid>
    <field name="win.eventdata.user" type="pcre2">(?i)socrunner</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(cmd|wsmprovhost|winrshost|powershell)\.exe</field>
    <description>Suppression: Authorized SOAR Remediation UAC Cleanup</description>
  </rule>

  <!-- ===================================================================== -->
  <!-- STAGE 3: Persistence - Registry Run / RunOnce Keys (T1547.001)        -->
  <!-- ===================================================================== -->
  <rule id="100006" level="10">
    <if_sid>61614, 61615, 61616</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)CurrentVersion\\Run</field>
    <description>WARNING: Persistence Mechanism - Registry Run/RunOnce Key Created or Modified</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- Rule 100010: Child Suppression Rule (Level 0) for Authorized Remediation Cleanup -->
  <rule id="100010" level="0">
    <if_sid>100006</if_sid>
    <field name="win.eventdata.user" type="pcre2">(?i)socrunner</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(cmd|wsmprovhost|winrshost|powershell)\.exe</field>
    <description>Suppression: Authorized SOAR Remediation Persistence Key Cleanup</description>
  </rule>

  <!-- ===================================================================== -->
  <!-- STAGE 4: Credential Access - LSASS Memory Access (T1003.001)           -->
  <!-- ===================================================================== -->
  <rule id="100005" level="12">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe</field>
    <field name="win.eventdata.sourceImage" type="pcre2" negate="yes">(?i)(MsMpEng\.exe|wmiprvse\.exe)</field>
    <field name="win.eventdata.grantedAccess" type="pcre2" negate="yes">^0x1000$</field>
    <description>CRITICAL WARNING: Suspicious Process Access to LSASS detected (Potential Credential Dumping)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  <!-- ===================================================================== -->
  <!-- NIDS SCENARIO 1: Network Reconnaissance - Nmap Port Scan (T1046)      -->
  <!-- ===================================================================== -->
  <rule id="100011" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(Nmap|Port Scan|SYN Scan)</field>
    <description>WARNING: Nmap Port Scanning / Reconnaissance Detected on Wire by Suricata NIDS</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!-- ===================================================================== -->
  <!-- NIDS SCENARIO 2: Web Exploit - LFI / Path Traversal on Wire (T1190)    -->
  <!-- ===================================================================== -->
  <rule id="100012" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(Path Traversal|Local File Inclusion|LFI)</field>
    <description>CRITICAL WARNING: Web Path Traversal / Local File Inclusion Attempt Detected on Wire by Suricata NIDS</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- ===================================================================== -->
  <!-- NIDS SCENARIO 3: Active Scanning - Vulnerability Probing (T1595.002)   -->
  <!-- ===================================================================== -->
  <rule id="100013" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(Vulnerability Scanner|Nikto|sqlmap|DirBuster|Gobuster)</field>
    <description>WARNING: Automated Vulnerability Scanner Probing (Nikto / Sqlmap / Gobuster) Detected on Wire by Suricata NIDS</description>
    <mitre>
      <id>T1595.002</id>
    </mitre>
  </rule>

</group>
